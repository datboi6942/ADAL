# ADAL Configuration
LLM_PROVIDER=deepseek

# DeepSeek (default provider)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
REASONING_EFFORT=max

# OpenAI (LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# LLM_MODEL=gpt-4o

# OpenRouter (LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# LLM_MODEL=deepseek/deepseek-v4-pro

# Ollama — local (LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# Custom endpoint (LLM_PROVIDER=custom)
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=
# CUSTOM_MODEL=

# General
DATABASE_URL=sqlite+aiosqlite:///adal.db
MAX_ITERATIONS=10
SANDBOX_TIMEOUT=120
# Python binary for sandbox subprocess (defaults to current interpreter; set to "python" on native Windows)
# ADAL_PYTHON_BIN=
LOG_LEVEL=INFO
LLM_MAX_TOKENS=65536

# Pricing (per 1M tokens, for cost tracking)
LLM_INPUT_PRICE_PER_MTOK=0.435
LLM_CACHED_PRICE_PER_MTOK=0.003625
LLM_OUTPUT_PRICE_PER_MTOK=0.87

# OpenAI API (for vector memory embeddings, separate from LLM)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Memory (optional)
MEMORY_ENABLED=true
MEMORY_DB_PATH=./memory_vault.lance
MEMORY_PRUNE_THRESHOLD=0.85

# Agent generation parameters
PROPOSER_TEMPERATURE=0.7
VERIFIER_TEMPERATURE=0.3
PLANNER_TEMPERATURE=0.4
FORCED_ANSWER_TEMPERATURE=0.1
